# GitHub Copilot authentication is OAuth-based (device flow).
# setup.sh or scripts/authenticate.sh performs authentication via GitHub.
# No API key env var is needed for Copilot — the token is stored locally.

LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-foo-bar-baz
LITELLM_LOCAL_MODEL_COST_MAP=true

UI_USERNAME=litellm
UI_PASSWORD=litellm

POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm

# PII guardrail (Microsoft Presidio). These are Docker service DNS names and
# only resolve inside the compose network. For the native fallback path
# (scripts/start_proxy.sh) see the "PII guardrail" section in the README.
PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
